# =================================================================
# FINOVA AI - PAYPAL SANDBOX & BACKEND ENVIRONMENT CONFIGURATION
# =================================================================

# 1. PayPal Developer Sandbox Credentials
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Webhook configuration (from PayPal Developer Webhooks panel)
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# 2. Database Configuration
# Default: SQLite for local zero-setup dev. Can be replaced with PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/finova
DATABASE_URL=sqlite:///./finova.db

# 3. AI & LLM Configuration
# Optional: Google Gemini API key for natural language financial assistant
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Security & Authentication Configuration
# Generate a cryptographically random 32+ character key for JWT signing:
# openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_string_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=120
MAX_REQUEST_SIZE_BYTES=10485760

# 5. Network, Rate Limiting & Proxy Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
# Optional in dev (uses local in-memory fallback); REQUIRED in production for multi-worker rate limiting:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
# Only enable TRUST_PROXY_HEADERS=true when TRUSTED_PROXY_IPS contains verified proxy CIDRs/IPs (and set FORWARDED_ALLOW_IPS).
# Render does not publish static internal ingress proxy CIDRs; leave false unless terminating behind a known proxy.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# 6. Out-of-Band Email / SMTP Configuration (Optional; required for self-service password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
